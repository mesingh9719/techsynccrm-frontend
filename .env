# Full base URL of the API, including /api. In development "/api" goes through the Vite proxy
# to http://localhost:5000 (see vite.config.ts), which keeps the auth cookie same-origin.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8900
VITE_CRM_CAPTURE_API=true
VITE_CRM_ASSIGNMENT_API=true
