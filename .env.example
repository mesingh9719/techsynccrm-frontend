# Full base URL of the API, including the /api prefix.
# Development: "/api" (proxied to the backend by Vite — see vite.config.ts).
# Production: the deployed API, e.g. https://api.techsynccrm.com/api
#   (if the API is on a different site, set COOKIE_SAMESITE=none on the backend).
VITE_API_BASE_URL=/api
# Optional: where the dev proxy forwards /api (defaults to http://localhost:5000)
# VITE_API_PROXY_TARGET=http://localhost:5000
