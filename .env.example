# Full base URL of the API, including the /api prefix.
# Development: "/api" (proxied to the backend by Vite — see vite.config.ts).
# Production: the deployed API, e.g. https://api.techsynccrm.com/api
#   (if the API is on a different site, set COOKIE_SAMESITE=none on the backend).
VITE_API_BASE_URL=/api
# Optional: where the dev proxy forwards /api (defaults to http://localhost:5000)
# VITE_API_PROXY_TARGET=http://localhost:5000

# Live M14/M15 adapters. Deploy the matching backend before enabling the frontend.
# Omitted values default to live; set false as a rollout stop switch.
# Disabled adapters show unavailable errors; they do not save previews or generate data.
# Web forms (M14): the backend serves /api/forms and /api/public/forms.
VITE_CRM_CAPTURE_API=true
# Assignment rules, working hours and out-of-office (M14): served by /api/assignment-rules, /api/working-hours, /api/users/me/out-of-office.
VITE_CRM_ASSIGNMENT_API=true
VITE_CRM_REPORTS_API=true
